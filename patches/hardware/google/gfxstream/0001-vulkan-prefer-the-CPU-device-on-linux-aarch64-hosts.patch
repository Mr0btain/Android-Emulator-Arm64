From 1174e1ea2701566f32f699a45577d873f3f95da8 Mon Sep 17 00:00:00 2001
From: Mr0btain <108532146+Mr0btain@users.noreply.github.com>
Date: Sat, 7 Nov 2026 12:34:20 -0500
Subject: [PATCH] vulkan: prefer the CPU device on linux-aarch64 hosts

Without stage-2 FWB, KVM rejects cacheable PFNMAP memslots, so mapping
GPU driver memory (e.g. Turnip on Snapdragon 8cx Gen 3) into the guest
fails with 'error registering slot'. Prefer llvmpipe; a GPU can still be
selected with ANDROID_EMU_VK_SELECT_GPU.
---
 host/vulkan/vk_common_operations.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/host/vulkan/vk_common_operations.cpp b/host/vulkan/vk_common_operations.cpp
index af7b9b2..eb3e8d0 100644
--- a/host/vulkan/vk_common_operations.cpp
+++ b/host/vulkan/vk_common_operations.cpp
@@ -700,6 +700,16 @@ int VkEmulation::getSelectedGpuIndex(
         const uint32_t patch = VK_API_VERSION_PATCH(deviceInfo.physdevProps.apiVersion);
         deviceScore += major * 5000 + std::min(minor, 10u) * 500 + std::min(patch, 400u);
 
+#if defined(__linux__) && defined(__aarch64__)
+        // On arm64 hosts without stage-2 FWB (e.g. Snapdragon 8cx Gen 3),
+        // KVM refuses to map cacheable GPU driver memory into the guest
+        // ("kvm_user_backed_ram_map: error registering slot"). Prefer the CPU
+        // (llvmpipe) device; ANDROID_EMU_VK_SELECT_GPU can still pick a GPU.
+        if (deviceType == VK_PHYSICAL_DEVICE_TYPE_CPU) {
+            deviceScore += 100000;
+        }
+#endif
+
         return deviceScore;
     };
 
