From dbdef06e0c8123a227d72c462f5c781a0faeb99d Mon Sep 17 00:00:00 2001
From: nick <wnbarbe1@gmail.com>
Date: Wed, 28 Oct 2026 20:33:43 -0400
Subject: [PATCH 3/4] build: skip symbol extraction when crash upload is
 disabled

Native aarch64 builds are no longer treated as cross-compiles, so they
reached the dump_syms post-build step, which has no host binary here.
---
 android/build/cmake/symbols.cmake | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/android/build/cmake/symbols.cmake b/android/build/cmake/symbols.cmake
index 60d4c7a9..bd5510f7 100644
--- a/android/build/cmake/symbols.cmake
+++ b/android/build/cmake/symbols.cmake
@@ -36,6 +36,11 @@ function(android_upload_symbols)
         return()
   endif()
 
+  if (OPTION_CRASHUPLOAD STREQUAL "NONE")
+    # Symbols are only consumed by the crash server; skip dump_syms entirely.
+    return()
+  endif()
+
   # Parse arguments
   set(options)
   set(oneValueArgs TARGET API_KEY DIRECTORY URI)
