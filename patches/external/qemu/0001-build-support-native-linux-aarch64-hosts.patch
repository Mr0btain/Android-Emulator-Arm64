From d2fac4c394f5bb40612f9587850755bf32581718 Mon Sep 17 00:00:00 2001
From: nick <wnbarbe1@gmail.com>
Date: Wed, 28 Oct 2026 20:29:39 -0400
Subject: [PATCH 01/10] build: support native linux-aarch64 hosts

- toolchain.cmake: detect an aarch64 Linux host instead of assuming
  linux-x86_64, so a linux-aarch64 target is a native build.
- gen-android-sdk-toolchain.sh: find libstdc++ in the multiarch path
  used by native aarch64 installs.
- configure/compile tasks: fall back to cmake on PATH when the x86
  prebuilt is absent.
---
 android/build/cmake/toolchain.cmake               | 10 +++++++++-
 android/build/python/aemu/tasks/compile.py        |  4 ++--
 android/build/python/aemu/tasks/configure.py      |  2 +-
 android/scripts/unix/gen-android-sdk-toolchain.sh |  8 +++++++-
 4 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/android/build/cmake/toolchain.cmake b/android/build/cmake/toolchain.cmake
index 1fa863f9..37a73851 100644
--- a/android/build/cmake/toolchain.cmake
+++ b/android/build/cmake/toolchain.cmake
@@ -190,7 +190,13 @@ function(_get_host_tag RET_VAL)
       set(${RET_VAL} "darwin-aarch64" PARENT_SCOPE)
     endif()
   elseif(UNIX)
-    set(${RET_VAL} "linux-x86_64" PARENT_SCOPE)
+    execute_process(COMMAND uname -m OUTPUT_VARIABLE CPU_ARCH
+                    OUTPUT_STRIP_TRAILING_WHITESPACE)
+    if(CPU_ARCH MATCHES "aarch64|arm64")
+      set(${RET_VAL} "linux-aarch64" PARENT_SCOPE)
+    else()
+      set(${RET_VAL} "linux-x86_64" PARENT_SCOPE)
+    endif()
   else()
     set(${RET_VAL} "windows_msvc-x86_64" PARENT_SCOPE)
   endif()
@@ -258,6 +264,8 @@ function(toolchain_configure_tags tag)
     set(HOST_WINDOWS TRUE PARENT_SCOPE)
   elseif(ANDROID_HOST_TAG STREQUAL "linux-x86_64")
     set(HOST_LINUX_X86_64 TRUE PARENT_SCOPE)
+  elseif(ANDROID_HOST_TAG STREQUAL "linux-aarch64")
+    set(HOST_LINUX_AARCH64 TRUE PARENT_SCOPE)
   elseif(ANDROID_HOST_TAG STREQUAL "darwin-x86_64")
     set(HOST_DARWIN_X86_64 TRUE PARENT_SCOPE)
   elseif(ANDROID_HOST_TAG STREQUAL "darwin-aarch64")
diff --git a/android/build/python/aemu/tasks/compile.py b/android/build/python/aemu/tasks/compile.py
index 7c13766c..9e0be59d 100644
--- a/android/build/python/aemu/tasks/compile.py
+++ b/android/build/python/aemu/tasks/compile.py
@@ -52,7 +52,7 @@ class CompileTask(BuildTask):
             aosp / "prebuilts" / "cmake" / f"{platform.system().lower()}-x86" / "bin"
         )
         self.cmake_cmd = [
-            shutil.which("cmake", path=str(cmake_dir)),
+            shutil.which("cmake", path=str(cmake_dir)) or shutil.which("cmake"),
             "--build",
             destination,
             "--target",
@@ -63,7 +63,7 @@ class CompileTask(BuildTask):
             Path(destination) / "distribution-unstripped" / "emulator"
         )
         self.cmake_cmd_unstripped = [
-            shutil.which("cmake", path=str(cmake_dir)),
+            shutil.which("cmake", path=str(cmake_dir)) or shutil.which("cmake"),
             "--install",
             destination,
             "--prefix",
diff --git a/android/build/python/aemu/tasks/configure.py b/android/build/python/aemu/tasks/configure.py
index 53e7f694..e04b6b76 100644
--- a/android/build/python/aemu/tasks/configure.py
+++ b/android/build/python/aemu/tasks/configure.py
@@ -77,7 +77,7 @@ class ConfigureTask(BuildTask):
                 / f"{platform.system().lower()}-x86"
                 / "bin"
             ),
-        )
+        ) or shutil.which("cmake")
         self.cmake_cmd = [
             cmake,
             f"-B{destination}",
diff --git a/android/scripts/unix/gen-android-sdk-toolchain.sh b/android/scripts/unix/gen-android-sdk-toolchain.sh
index 4d2340fa..8e9a2933 100755
--- a/android/scripts/unix/gen-android-sdk-toolchain.sh
+++ b/android/scripts/unix/gen-android-sdk-toolchain.sh
@@ -1060,7 +1060,13 @@ print_info () {
             ;;
         libcplusplus)
             if [ "$BUILD_HOST" = "linux" -a "$BUILD_ARCH" = "aarch64" ]; then
-                printf "%s\n" "/usr/aarch64-linux-gnu/lib/libstdc++.so.6"
+                # Native aarch64 hosts use the multiarch layout, cross
+                # toolchains the /usr/<triple> one.
+                if [ -f /usr/lib/aarch64-linux-gnu/libstdc++.so.6 ]; then
+                    printf "%s\n" "/usr/lib/aarch64-linux-gnu/libstdc++.so.6"
+                else
+                    printf "%s\n" "/usr/aarch64-linux-gnu/lib/libstdc++.so.6"
+                fi
             else
                 printf "%s\n" "$CLANG_DIR/lib/x86_64-unknown-linux-gnu/libc++.so"
             fi
