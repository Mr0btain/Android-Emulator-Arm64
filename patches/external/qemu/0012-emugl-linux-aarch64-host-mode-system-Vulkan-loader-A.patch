From 3806d36b7dea4d50ebce1ad17cb6cd41c4e6f110 Mon Sep 17 00:00:00 2001
From: Mr0btain <108532146+Mr0btain@users.noreply.github.com>
Date: Sat, 7 Nov 2026 12:58:53 -0500
Subject: [PATCH 12/12] emugl: linux-aarch64 'host' mode: system Vulkan loader,
 API 37+ only

- emuglConfig_get_vulkan_runtime_full_path: fall back to the system
  libvulkan.so.1 when no loader is bundled (the pre-boot Vulkan check
  was fatal without it).
- Enable GuestAngle/Vulkan via setEnabledOverride once the final GPU
  choice is 'host' (the guest-disabled-aware setter skipped it).
- API < 37 images hang with this path (guest Vulkan QSRI sync fd errors
  on API 35), so they fall back to swiftshader.
---
 .../aemu-gl-init/src/android/main-emugl.cpp   | 32 ++++++++++++++-----
 .../src/android/opengl/emugl_config.cpp       |  8 +++++
 2 files changed, 32 insertions(+), 8 deletions(-)

diff --git a/android/android-ui/modules/aemu-gl-init/src/android/main-emugl.cpp b/android/android-ui/modules/aemu-gl-init/src/android/main-emugl.cpp
index cb654641..9d7b78b3 100644
--- a/android/android-ui/modules/aemu-gl-init/src/android/main-emugl.cpp
+++ b/android/android-ui/modules/aemu-gl-init/src/android/main-emugl.cpp
@@ -118,14 +118,6 @@ void convertGpuOptionsToFeatureFlags(
             fc::isEnabled(fc::ForceLavapipeForSoftwareRendering);
     if (gpuChoice == "host") {
         feature_set_if_not_overridden(kFeature_ForceGpuHost, true);
-#if defined(__linux__) && defined(__aarch64__)
-        // Native linux-aarch64 builds don't ship ANGLE's host shader
-        // translator, so host GLES translation can't work. Render GLES with
-        // ANGLE inside the guest on top of gfxstream Vulkan instead.
-        feature_set_if_not_overridden_or_guest_disabled(kFeature_GuestAngle,
-                                                        true);
-        feature_set_if_not_overridden(kFeature_Vulkan, true);
-#endif
     } else if (gpuChoice == "software") {
         // "software" is a special term to select best software mode for the
         // platform/avd and not a real gpu backend mode.
@@ -200,6 +192,30 @@ bool androidEmuglConfigInit(
         }
     }
 
+#if defined(__linux__) && defined(__aarch64__)
+    // Native linux-aarch64 builds don't ship ANGLE's host shader translator,
+    // so host GLES translation can't work. For 'host', render GLES with ANGLE
+    // inside the guest on top of gfxstream Vulkan instead (same as
+    // -feature GuestAngle,Vulkan).
+    // Tested: API 37 images boot this way. The API 35 image's guest Vulkan
+    // driver hangs at boot (QSRI sync fd export fails), so older images
+    // fall back to software rendering.
+    if (gpuChoice == "host") {
+        if (apiLevel >= 37) {
+            dinfo("linux-aarch64: 'host' GPU mode uses guest ANGLE on Vulkan");
+            fc::setEnabledOverride(fc::GuestAngle, true);
+            fc::setEnabledOverride(fc::Vulkan, true);
+        } else {
+            dwarning("linux-aarch64: 'host' GPU mode needs API 37+ here "
+                     "(this AVD is API %d); using software rendering.",
+                     apiLevel);
+            gpuChoice = "swiftshader";
+            fc::setEnabledOverride(fc::ForceGpuHost, false);
+            fc::setEnabledOverride(fc::ForceSwiftshader, true);
+        }
+    }
+#endif
+
     bool hostGpuDenylisted = false;
 
     // Only check the blacklist for 'auto' and 'host' modes.
diff --git a/android/android-ui/modules/aemu-gl-init/src/android/opengl/emugl_config.cpp b/android/android-ui/modules/aemu-gl-init/src/android/opengl/emugl_config.cpp
index 27dda44f..76424b5a 100644
--- a/android/android-ui/modules/aemu-gl-init/src/android/opengl/emugl_config.cpp
+++ b/android/android-ui/modules/aemu-gl-init/src/android/opengl/emugl_config.cpp
@@ -441,6 +441,14 @@ const char* emuglConfig_get_vulkan_runtime_full_path() {
     }
 #endif
 
+#if defined(__linux__)
+    // No bundled loader (native linux-aarch64 builds): use the system one,
+    // which gfxstream also falls back to.
+    if (!System::get()->pathExists(selectedPath)) {
+        selectedPath = "libvulkan.so.1";
+    }
+#endif
+
     sVkRuntimePath = selectedPath;
     dprint("%s: Using vulkan runtime path: %s", __func__,
            sVkRuntimePath.c_str());
